@page "/app/{Ws:guid}/cla/{Id:guid}/temporada"
@inject ApiClient Api
<PageTitle>Temporada — ClanHub</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.End" Class="mb-2" Wrap="Wrap.Wrap">
    <MudSelect T="string" @bind-Value="_season" Label="Temporada" @bind-Value:after="Load">
        @foreach (var s in _seasons)
        {
            <MudSelectItem T="string" Value="@s">@(s == "current" ? "Atual" : s)</MudSelectItem>
        }
    </MudSelect>
    @if (Ctx.IsStaff)
    {
        <MudButton Href="@($"/api/v1/clans/{Id}/reports/season?format=csv")" Target="_blank" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download">Exportar CSV</MudButton>
    }
</MudStack>

@if (_rows is null) { <MudProgressLinear Indeterminate="true" /> }
else if (_rows.Count == 0) { <MudText>Sem dados para esta temporada.</MudText> }
else
{
    <div class="table-scroll">
        <MudSimpleTable Dense="true" Hover="true">
            <thead><tr><th>#</th><th>Jogador</th><th>Doou</th><th>Recebeu</th></tr></thead>
            <tbody>
            @{ var n = 0; }
            @foreach (var r in _rows)
            {
                n++;
                <tr><td>@n</td><td>@r.Name</td><td>@r.Donations</td><td>@r.Received</td></tr>
            }
            </tbody>
        </MudSimpleTable>
    </div>
    <MudText Typo="Typo.caption" Class="mt-2">As doações zeram a cada temporada; o total da temporada anterior é guardado quando a virada é detectada.</MudText>
}

@code {
    [Parameter] public Guid Ws { get; set; }
    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] public ClanContext Ctx { get; set; } = default!;

    private List<string> _seasons = ["current"];
    private string _season = "current";
    private List<SeasonStatRowDto>? _rows;

    protected override async Task OnInitializedAsync()
    {
        var list = await Api.Get<SeasonListDto>($"/api/v1/clans/{Id}/seasons");
        if (list.Ok) _seasons = list.Value!.Seasons.ToList();
        await Load();
    }

    private async Task Load() =>
        _rows = (await Api.Get<List<SeasonStatRowDto>>($"/api/v1/clans/{Id}/seasons/{Uri.EscapeDataString(_season)}/stats")).Value ?? [];
}