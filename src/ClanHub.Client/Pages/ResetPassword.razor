@page "/redefinir-senha"
@inject ApiClient Api
<PageTitle>Nova senha — ClanHub</PageTitle>

<div class="page" style="max-width:480px">
    <MudText Typo="Typo.h4" GutterBottom="true">Definir nova senha</MudText>
    @if (_done)
    {
        <MudAlert Severity="Severity.Success">Senha alterada! Você já pode entrar.</MudAlert>
        <MudButton Href="/entrar" Class="mt-4" Variant="Variant.Filled" Color="Color.Primary">Entrar</MudButton>
    }
    else
    {
        <MudTextField @bind-Value="_email" Label="E-mail" InputType="InputType.Email" />
        <MudTextField @bind-Value="_code" Label="Código recebido por e-mail" />
        <MudTextField @bind-Value="_password" Label="Nova senha" InputType="InputType.Password"
                      HelperText="Mínimo de 8 caracteres, com maiúscula, minúscula, número e símbolo." />
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert> }
        <MudButton OnClick="Submit" Disabled="_busy" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4">Salvar nova senha</MudButton>
    }
</div>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Code { get; set; }

    private string _email = "", _code = "", _password = "";
    private bool _busy, _done;
    private string? _error;

    protected override void OnParametersSet()
    {
        if (_email.Length == 0 && Email is not null) _email = Email;
        if (_code.Length == 0 && Code is not null) _code = Code;
    }

    private async Task Submit()
    {
        _busy = true; _error = null;
        var r = await Api.PostOk("/api/auth/resetPassword", new { email = _email.Trim(), resetCode = _code.Trim(), newPassword = _password });
        _busy = false;
        if (r.Ok) _done = true; else _error = string.IsNullOrWhiteSpace(r.Error) ? "Código inválido ou senha fraca." : r.Error;
    }
}