@page "/recuperar-senha"
@inject ApiClient Api
<PageTitle>Recuperar senha — ClanHub</PageTitle>

<div class="page" style="max-width:480px">
    <MudText Typo="Typo.h4" GutterBottom="true">Recuperar senha</MudText>
    @if (_sent)
    {
        <MudAlert Severity="Severity.Success">Se o e-mail estiver cadastrado, enviamos as instruções para redefinir a senha.</MudAlert>
    }
    else
    {
        <MudTextField @bind-Value="_email" Label="E-mail" InputType="InputType.Email" />
        <MudButton OnClick="Submit" Disabled="_busy" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4">Enviar instruções</MudButton>
    }
    <MudText Class="mt-4"><MudLink Href="/entrar">Voltar ao login</MudLink></MudText>
</div>

@code {
    private string _email = "";
    private bool _sent, _busy;

    private async Task Submit()
    {
        _busy = true;
        await Api.PostOk("/api/auth/forgotPassword", new { email = _email.Trim() });
        _busy = false;
        _sent = true;
    }
}